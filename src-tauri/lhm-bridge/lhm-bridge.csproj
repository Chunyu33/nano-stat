<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：Windows GUI 子系统，启动时不弹出控制台窗口（stdout 管道仍正常，Rust 端可读取 JSON） -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lhm-bridge</AssemblyName>
    <RootNamespace>LhmBridge</RootNamespace>
    <!-- NativeAOT 发布：单文件、免 .NET 运行时 -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 控制台输出保持 UTF-8，便于 Rust 端解析 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- 关闭不必要的分析器 -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
